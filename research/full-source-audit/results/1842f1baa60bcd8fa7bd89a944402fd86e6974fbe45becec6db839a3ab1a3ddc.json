  "hits": [
    {
      "path": "README.mbt.md",
      "line": 247,
      "kinds": [
        "clock_sync"
      ],
      "text": "`ZoneOffset::utc()` supplies UTC. Clock reads can fail and are translated to",
      "excerpt_start_column": 1,
      "match_column": 6
