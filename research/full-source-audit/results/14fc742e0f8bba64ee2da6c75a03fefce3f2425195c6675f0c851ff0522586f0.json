      "match_column": 10
    },
    {
      "path": "tui_app/app_test.mbt",
      "line": 14,
      "kinds": [
        "ptp_messages"
      ],
      "text": "      #|  Follow-up: first",
      "excerpt_start_column": 1,
      "match_column": 11
    },
    {
      "path": "sdk/agent_loop/agent_loop.mbt",
      "line": 24,
      "kinds": [
        "ptp_messages"
      ],
      "text": "  // TODO: support follow-up channel",
      "excerpt_start_column": 1,
      "match_column": 20
    },
    {
      "path": "sdk/agent_loop/agent_loop_test.mbt",
      "line": 163,
      "kinds": [
        "ptp_messages"
      ],
      "text": "  // One provider call: `end` cancelled the pending tool follow-up.",
