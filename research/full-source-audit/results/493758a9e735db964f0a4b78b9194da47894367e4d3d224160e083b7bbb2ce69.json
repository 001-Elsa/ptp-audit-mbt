  "hits": [
    {
      "path": "docs/DESIGN.md",
      "line": 99,
      "kinds": [
        "protocol_capture_audit"
      ],
      "text": "Workflow-spec JSON is a separate input contract. It only describes task metadata and dependency edges; it deliberately does not preserve runtime status or trace events. Import validates JSON syntax, field types, schema version, duplicate ids, duplicate edges, missing endpoints, and cycles. Unknown fields are accepted but ignored so upstream tools can carry their own metadata without forcing MoonFlowGraph to own it.",
      "excerpt_start_column": 1,
      "match_column": 156
    },
    {
      "path": "PROJECT.md",
      "line": 324,
      "kinds": [
        "protocol_capture_audit"
      ],
      "text": "- `bash run_audit.sh examples/research-run-snapshot-v1.json` 输出任务、依赖、批次和 trace 计数，并确认 `Audit: valid`。",
      "excerpt_start_column": 1,
      "match_column": 74
    }
