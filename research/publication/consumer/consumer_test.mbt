///|
test "audit positive" {
  let report = @ptp.audit_json("{\n  \"schema\": \"ptp-audit/v1\",\n  \"profile\": \"default-e2e-two-step-2008\",\n  \"frames\": [\n    {\n      \"id\": 1,\n      \"epoch\": 0,\n      \"payload_hex\": \"0002002c00000200ffffffffffff800000000000001122334455667700010007000000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1300\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"rx\"\n    },\n    {\n      \"id\": 2,\n      \"epoch\": 0,\n      \"payload_hex\": \"0802002c000000000000000000004000000000000011223344556677000100070200000000000064000003e8\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 3,\n      \"epoch\": 0,\n      \"payload_hex\": \"0102002c0000000000000000000f423f000000008899aabbccddeeff0001001f010000000000006400001388\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"tx\"\n    },\n    {\n      \"id\": 4,\n      \"epoch\": 0,\n      \"payload_hex\": \"0902003600000000000000000000c0000000000000112233445566770001001f0300000000000064000014828899aabbccddeeff0001\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5250\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 5,\n      \"epoch\": 0,\n      \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566770001000705000000000000640000000000250064f82243218000112233445566770000a0\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 6,\n      \"epoch\": 0,\n      \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566780001000705000000000000640000000000250078f82243218000112233445566780000a0\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  },\n  \"pair_claims\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2\n    }\n  ],\n  \"exchanges\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2,\n      \"delay_req\": 3,\n      \"delay_resp\": 4\n    }\n  ],\n  \"assumptions\": {\n    \"symmetric_path\": true,\n    \"timestamp_provenance\": true,\n    \"stable_rates\": true\n  },\n  \"bmca\": {\n    \"candidates\": [\n      {\n        \"id\": \"A\",\n        \"frame\": 5,\n        \"receiver\": {\n          \"clock\": \"8899aabbccddeeff\",\n          \"port\": 1\n        }\n      },\n      {\n        \"id\": \"B\",\n        \"frame\": 6,\n        \"receiver\": {\n          \"clock\": \"8899aabbccddeeff\",\n          \"port\": 1\n        }\n      }\n    ],\n    \"selected\": \"A\",\n    \"candidates_complete\": true,\n    \"eligibility_confirmed\": true,\n    \"snapshot\": {\n      \"epoch\": 0,\n      \"window\": \"capture-0\",\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"decision_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 10000\n      },\n      \"announce_validity_ns\": 1000000000,\n      \"validity_source\": \"fixture-declared-observation-window\",\n      \"validity_confirmed\": true,\n      \"capture_window_confirmed\": true\n    }\n  }\n}\n")
  match @json.parse(report) {
    Object(fields) => {
      assert_true(fields.get("schema") is Some(String("ptp-audit-report/v2")))
      assert_true(fields.get("status") is Some(String("Pass")))
    }
    _ => fail("Expected report object")
  }
}

///|
test "commission positive" {
  let report = @ptp.commission_json("{\n  \"schema\": \"ptp-commission/v1\",\n  \"capture_clock_continuity\": {\n    \"source\": \"synthetic-single-slave-clock-lab-record\",\n    \"confirmed\": true\n  },\n  \"steps\": [\n    {\n      \"id\": \"before-change\",\n      \"case\": {\n        \"schema\": \"ptp-audit/v1\",\n        \"profile\": \"default-e2e-two-step-2008\",\n        \"frames\": [\n          {\n            \"id\": 1,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0002002c00000200ffffffffffff800000000000001122334455667700010007000000000000006400000000\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 1300\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"local_port\": {\n              \"clock\": \"8899aabbccddeeff\",\n              \"port\": 1\n            },\n            \"event_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 1300\n            },\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"direction\": \"rx\"\n          },\n          {\n            \"id\": 2,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0802002c000000000000000000004000000000000011223344556677000100070200000000000064000003e8\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 2000\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 3,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0102002c0000000000000000000f423f000000008899aabbccddeeff0001001f010000000000006400001388\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 5000\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"local_port\": {\n              \"clock\": \"8899aabbccddeeff\",\n              \"port\": 1\n            },\n            \"event_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 5000\n            },\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"direction\": \"tx\"\n          },\n          {\n            \"id\": 4,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0902003600000000000000000000c0000000000000112233445566770001001f0300000000000064000014828899aabbccddeeff0001\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 5250\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 5,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566770001000705000000000000640000000000250064f82243218000112233445566770000a0\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 0\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 6,\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566780001000705000000000000640000000000250078f82243218000112233445566780000a0\",\n            \"capture_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 0\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          }\n        ],\n        \"observation\": {\n          \"windows\": [\n            {\n              \"id\": \"commission-window-0\",\n              \"epoch\": 0,\n              \"clock_domain\": \"synthetic-slave-monotonic-0\",\n              \"start\": {\n                \"seconds\": \"100\",\n                \"nanos\": 0\n              },\n              \"end\": {\n                \"seconds\": \"100\",\n                \"nanos\": 100000\n              },\n              \"complete\": true\n            }\n          ],\n          \"policy\": {\n            \"source\": \"synthetic-commissioning-lab-policy\",\n            \"sync_follow_up_ns\": 1000000000,\n            \"delay_response_ns\": 1000000000\n          }\n        },\n        \"pair_claims\": [\n          {\n            \"sync\": 1,\n            \"follow_up\": 2\n          }\n        ],\n        \"exchanges\": [\n          {\n            \"sync\": 1,\n            \"follow_up\": 2,\n            \"delay_req\": 3,\n            \"delay_resp\": 4\n          }\n        ],\n        \"assumptions\": {\n          \"symmetric_path\": true,\n          \"timestamp_provenance\": true,\n          \"stable_rates\": true\n        },\n        \"bmca\": {\n          \"candidates\": [\n            {\n              \"id\": \"A\",\n              \"frame\": 5,\n              \"receiver\": {\n                \"clock\": \"8899aabbccddeeff\",\n                \"port\": 1\n              }\n            },\n            {\n              \"id\": \"B\",\n              \"frame\": 6,\n              \"receiver\": {\n                \"clock\": \"8899aabbccddeeff\",\n                \"port\": 1\n              }\n            }\n          ],\n          \"selected\": \"A\",\n          \"candidates_complete\": true,\n          \"eligibility_confirmed\": true,\n          \"snapshot\": {\n            \"epoch\": 0,\n            \"window\": \"commission-window-0\",\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"decision_time\": {\n              \"seconds\": \"100\",\n              \"nanos\": 500\n            },\n            \"announce_validity_ns\": 1000000000,\n            \"validity_source\": \"synthetic-explicit-announce-window\",\n            \"validity_confirmed\": true,\n            \"capture_window_confirmed\": true\n          }\n        }\n      },\n      \"selection_stability\": {\n        \"source\": \"synthetic-lab-controller-selection-record\",\n        \"confirmed\": true,\n        \"until\": {\n          \"seconds\": \"100\",\n          \"nanos\": 100000\n        }\n      }\n    },\n    {\n      \"id\": \"after-change\",\n      \"case\": {\n        \"schema\": \"ptp-audit/v1\",\n        \"profile\": \"default-e2e-two-step-2008\",\n        \"frames\": [\n          {\n            \"id\": 1,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0002002c00000200ffffffffffff800000000000001122334455667800010007000000000000006500000000\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 1300\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"local_port\": {\n              \"clock\": \"8899aabbccddeeff\",\n              \"port\": 1\n            },\n            \"event_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 1300\n            },\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"direction\": \"rx\"\n          },\n          {\n            \"id\": 2,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0802002c000000000000000000004000000000000011223344556678000100070200000000000065000003e8\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 2000\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 3,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0102002c0000000000000000000f423f000000008899aabbccddeeff0001001f010000000000006500001388\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 5000\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"local_port\": {\n              \"clock\": \"8899aabbccddeeff\",\n              \"port\": 1\n            },\n            \"event_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 5000\n            },\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"direction\": \"tx\"\n          },\n          {\n            \"id\": 4,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0902003600000000000000000000c0000000000000112233445566780001001f0300000000000065000014828899aabbccddeeff0001\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 5250\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 5,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566770001000705000000000000650000000000250078f82243218000112233445566770000a0\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 0\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          },\n          {\n            \"id\": 6,\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566780001000705000000000000650000000000250064f82243218000112233445566780000a0\",\n            \"capture_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 0\n            },\n            \"capture_clock_domain\": \"synthetic-slave-monotonic-0\"\n          }\n        ],\n        \"observation\": {\n          \"windows\": [\n            {\n              \"id\": \"commission-window-1\",\n              \"epoch\": 1,\n              \"clock_domain\": \"synthetic-slave-monotonic-0\",\n              \"start\": {\n                \"seconds\": \"101\",\n                \"nanos\": 0\n              },\n              \"end\": {\n                \"seconds\": \"101\",\n                \"nanos\": 100000\n              },\n              \"complete\": true\n            }\n          ],\n          \"policy\": {\n            \"source\": \"synthetic-commissioning-lab-policy\",\n            \"sync_follow_up_ns\": 1000000000,\n            \"delay_response_ns\": 1000000000\n          }\n        },\n        \"pair_claims\": [\n          {\n            \"sync\": 1,\n            \"follow_up\": 2\n          }\n        ],\n        \"exchanges\": [\n          {\n            \"sync\": 1,\n            \"follow_up\": 2,\n            \"delay_req\": 3,\n            \"delay_resp\": 4\n          }\n        ],\n        \"assumptions\": {\n          \"symmetric_path\": true,\n          \"timestamp_provenance\": true,\n          \"stable_rates\": true\n        },\n        \"bmca\": {\n          \"candidates\": [\n            {\n              \"id\": \"A\",\n              \"frame\": 5,\n              \"receiver\": {\n                \"clock\": \"8899aabbccddeeff\",\n                \"port\": 1\n              }\n            },\n            {\n              \"id\": \"B\",\n              \"frame\": 6,\n              \"receiver\": {\n                \"clock\": \"8899aabbccddeeff\",\n                \"port\": 1\n              }\n            }\n          ],\n          \"selected\": \"B\",\n          \"candidates_complete\": true,\n          \"eligibility_confirmed\": true,\n          \"snapshot\": {\n            \"epoch\": 1,\n            \"window\": \"commission-window-1\",\n            \"clock_domain\": \"synthetic-slave-monotonic-0\",\n            \"decision_time\": {\n              \"seconds\": \"101\",\n              \"nanos\": 500\n            },\n            \"announce_validity_ns\": 1000000000,\n            \"validity_source\": \"synthetic-explicit-announce-window\",\n            \"validity_confirmed\": true,\n            \"capture_window_confirmed\": true\n          }\n        }\n      },\n      \"selection_stability\": {\n        \"source\": \"synthetic-lab-controller-selection-record\",\n        \"confirmed\": true,\n        \"until\": {\n          \"seconds\": \"101\",\n          \"nanos\": 100000\n        }\n      }\n    }\n  ]\n}\n")
  match @json.parse(report) {
    Object(fields) => {
      assert_true(fields.get("schema") is Some(String("ptp-commission-report/v1")))
      assert_true(fields.get("status") is Some(String("Pass")))
    }
    _ => fail("Expected report object")
  }
}

///|
test "audit malformed" {
  let report = @ptp.audit_json("{}")
  match @json.parse(report) {
    Object(fields) => {
      assert_true(fields.get("schema") is Some(String("ptp-audit-report/v2")))
      assert_true(fields.get("status") is Some(String("Violation")))
    }
    _ => fail("Expected report object")
  }
}

///|
test "commission malformed" {
  let report = @ptp.commission_json("{}")
  match @json.parse(report) {
    Object(fields) => {
      assert_true(fields.get("schema") is Some(String("ptp-commission-report/v1")))
      assert_true(fields.get("status") is Some(String("Violation")))
    }
    _ => fail("Expected report object")
  }
}
