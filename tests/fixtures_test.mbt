///|
test "fixture schema-invalid" {
  let r = @audit.audit("{}\n")
  assert_eq(r.status().label(), "Violation")
  assert_true(r.findings.any(fn(f) { f.rule == "INPUT.SCHEMA" }))
  assert_eq(r.measurements.length(), 0)
}

///|
test "fixture wire-only" {
  let r = @audit.audit(
    "{\"schema\":\"ptp-audit/v1\",\"profile\":\"default-e2e-two-step-2008\",\"frames\":[],\"pair_claims\":[],\"exchanges\":[],\"assumptions\":{\"symmetric_path\":false,\"timestamp_provenance\":false,\"stable_rates\":false}}\n",
  )
  assert_eq(r.status().label(), "InsufficientEvidence")
  assert_true(r.findings.any(fn(f) { f.rule == "SCOPE.NO_SEMANTIC_CHECK" }))
  assert_eq(r.measurements.length(), 0)
}

///|
test "parser duplicate keys" {
  assert_eq(@audit.audit("{\"schema\":\"a\",\"schema\":\"b\"}").exit_code(), 1)
}

///|
test "parser malformed JSON" {
  assert_eq(@audit.audit("[").exit_code(), 1)
}

///|
test "parser deep nesting" {
  assert_eq(
    @audit.audit(
      "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]",
    ).exit_code(),
    1,
  )
}
