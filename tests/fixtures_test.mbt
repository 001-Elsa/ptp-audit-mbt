    "{\n  \"schema\": \"ptp-audit/v1\",\n  \"profile\": \"default-e2e-two-step-2008\",\n  \"frames\": [\n    {\n      \"id\": 1,\n      \"epoch\": 0,\n      \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566770001000705000000000000640000000000250001f82243218000112233445566770000a0\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 2,\n      \"epoch\": 0,\n      \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566780001000705000000000000640000000000250002f82243218000112233445566780000a0\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 3,\n      \"epoch\": 0,\n      \"payload_hex\": \"0b0200400000000000000000000000000000000000112233445566790001000705000000000000640000000000250003f82243218000112233445566790000a0\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  },\n  \"bmca\": {\n    \"candidates\": [\n      {\n        \"id\": \"A\",\n        \"frame\": 1,\n        \"receiver\": {\n          \"clock\": \"8899aabbccddeeff\",\n          \"port\": 1\n        }\n      },\n      {\n        \"id\": \"B\",\n        \"frame\": 2,\n        \"receiver\": {\n          \"clock\": \"8899aabbccddeeff\",\n          \"port\": 1\n        }\n      },\n      {\n        \"id\": \"C\",\n        \"frame\": 3,\n        \"receiver\": {\n          \"clock\": \"8899aabbccddeeff\",\n          \"port\": 1\n        }\n      }\n    ],\n    \"selected\": \"A\",\n    \"candidates_complete\": true,\n    \"eligibility_confirmed\": true,\n    \"snapshot\": {\n      \"epoch\": 0,\n      \"window\": \"capture-0\",\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"decision_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 10000\n      },\n      \"announce_validity_ns\": 1000000000,\n      \"validity_source\": \"fixture-declared-observation-window\",\n      \"validity_confirmed\": true,\n      \"capture_window_confirmed\": true\n    }\n  }\n}\n",
  )
  assert_eq(r.status().label(), "Pass")
  assert_true(r.findings.any(fn(f) { f.rule == "BMCA.OBSERVED_DECISION" }))
  assert_eq(r.measurements.length(), 0)
}

