0000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  }\n}\n",
