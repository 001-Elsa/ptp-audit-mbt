///|
test "fixture wrong-response-sequence" {
  let r = @audit.audit(
    "{\n  \"schema\": \"ptp-audit/v1\",\n  \"profile\": \"default-e2e-two-step-2008\",\n  \"frames\": [\n    {\n      \"id\": 1,\n      \"epoch\": 0,\n      \"payload_hex\": \"0002002c00000200ffffffffffff800000000000001122334455667700010007000000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1300\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"rx\"\n    },\n    {\n      \"id\": 2,\n      \"epoch\": 0,\n      \"payload_hex\": \"0802002c000000000000000000004000000000000011223344556677000100070200000000000064000003e8\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 3,\n      \"epoch\": 0,\n      \"payload_hex\": \"0102002c0000000000000000000f423f000000008899aabbccddeeff0001001f010000000000006400001388\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"tx\"\n    },\n    {\n      \"id\": 4,\n      \"epoch\": 0,\n      \"payload_hex\": \"090200360000000000000000000000000000000000112233445566770001001e0300000000000064000014828899aabbccddeeff0001\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5250\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  },\n  \"pair_claims\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2\n    }\n  ],\n  \"exchanges\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2,\n      \"delay_req\": 3,\n      \"delay_resp\": 4\n    }\n  ],\n  \"assumptions\": {\n    \"symmetric_path\": true,\n    \"timestamp_provenance\": true,\n    \"stable_rates\": true\n  }\n}\n",
  )
  assert_eq(r.status().label(), "Violation")
  assert_true(r.findings.any(fn(f) { f.rule == "CLAIM.E2E_IDENTITY" }))
  assert_eq(r.measurements.length(), 0)
}

///|
test "fixture master-change-epoch" {
  let r = @audit.audit(
    "{\n  \"schema\": \"ptp-audit/v1\",\n  \"profile\": \"default-e2e-two-step-2008\",\n  \"frames\": [\n    {\n      \"id\": 1,\n      \"epoch\": 0,\n      \"payload_hex\": \"0002002c00000200ffffffffffff800000000000001122334455667700010007000000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1300\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"rx\"\n    },\n    {\n      \"id\": 2,\n      \"epoch\": 0,\n      \"payload_hex\": \"0802002c000000000000000000004000000000000011223344556677000100070200000000000064000003e8\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 1000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 3,\n      \"epoch\": 0,\n      \"payload_hex\": \"0102002c0000000000000000000f423f000000008899aabbccddeeff0001001f010000000000006400001388\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\",\n      \"local_port\": {\n        \"clock\": \"8899aabbccddeeff\",\n        \"port\": 1\n      },\n      \"event_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5000\n      },\n      \"clock_domain\": \"slave-monotonic-0\",\n      \"direction\": \"tx\"\n    },\n    {\n      \"id\": 4,\n      \"epoch\": 1,\n      \"payload_hex\": \"0902003600000000000000000000c0000000000000112233445566770001001f0300000000000064000014828899aabbccddeeff0001\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 5250\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  },\n  \"pair_claims\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2\n    }\n  ],\n  \"exchanges\": [\n    {\n      \"sync\": 1,\n      \"follow_up\": 2,\n      \"delay_req\": 3,\n      \"delay_resp\": 4\n    }\n  ],\n  \"assumptions\": {\n    \"symmetric_path\": true,\n    \"timestamp_provenance\": true,\n    \"stable_rates\": true\n  }\n}\n",
  )
  assert_eq(r.status().label(), "InsufficientEvidence")
  assert_true(r.findings.any(fn(f) { f.rule == "CLAIM.DELAY_WINDOW" }))
  assert_eq(r.measurements.length(), 0)
}

