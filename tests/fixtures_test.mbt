///|
test "fixture sequence-wrap" {
  let r = @audit.audit(
    "{\n  \"schema\": \"ptp-audit/v1\",\n  \"profile\": \"default-e2e-two-step-2008\",\n  \"frames\": [\n    {\n      \"id\": 1,\n      \"epoch\": 0,\n      \"payload_hex\": \"0002002c0000020000000000000000000000000000112233445566770001ffff000000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 2,\n      \"epoch\": 0,\n      \"payload_hex\": \"0802002c0000000000000000000000000000000000112233445566770001ffff020000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 3,\n      \"epoch\": 0,\n      \"payload_hex\": \"0002002c00000200000000000000000000000000001122334455667700010000000000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    },\n    {\n      \"id\": 4,\n      \"epoch\": 0,\n      \"payload_hex\": \"0802002c00000000000000000000000000000000001122334455667700010000020000000000006400000000\",\n      \"window\": \"capture-0\",\n      \"capture_time\": {\n        \"seconds\": \"100\",\n        \"nanos\": 0\n      },\n      \"capture_clock_domain\": \"slave-monotonic-0\"\n    }\n  ],\n  \"observation\": {\n    \"windows\": [\n      {\n        \"id\": \"capture-0\",\n        \"epoch\": 0,\n        \"clock_domain\": \"slave-monotonic-0\",\n        \"start\": {\n          \"seconds\": \"99\",\n          \"nanos\": 0\n        },\n        \"end\": {\n          \"seconds\": \"101\",\n          \"nanos\": 999999999\n        },\n        \"complete\": true\n      }\n    ],\n    \"policy\": {\n      \"source\": \"fixture-analysis-policy\",\n      \"sync_follow_up_ns\": 1000000000,\n      \"delay_response_ns\": 1000000000\n    }\n  }\n}\n",
  )
  assert_eq(r.status().label(), "Pass")
  assert_true(r.findings.any(fn(f) { f.rule == "EXCHANGE.SYNC_FOLLOW_UP" }))
  assert_eq(r.measurements.length(), 0)
}

